# =============================================================================
# RAGFLOW PORTAINER PRODUCTION ENVIRONMENT CONFIGURATION
# Cấu hình cổng dịch vụ bắt đầu từ dải 3060 trở đi (Tránh trùng cổng máy chủ)
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. CỔNG DỊCH VỤ (SERVICE PORTS - DẢI TỪ 3060 TRỞ ĐI)
# ─────────────────────────────────────────────────────────────────────────────
RAGFLOW_WEB_PORT=3060        # Cổng Web UI Frontend (Truy cập: http://<IP>:3060)
RAGFLOW_API_PORT=3061        # Cổng REST API & MCP Server (http://<IP>:3061)
RAGFLOW_ADMIN_PORT=3062      # Cổng Admin Management API (http://<IP>:3062)
RAGFLOW_HTTPS_PORT=3063      # Cổng Web HTTPS (nếu cấu hình SSL trực tiếp)

MINIO_API_PORT=3064          # Cổng MinIO S3 Storage API (http://<IP>:3064)
MINIO_CONSOLE_PORT=3065      # Cổng MinIO Web Console Dashboard (http://<IP>:3065)

MYSQL_EXPOSE_PORT=3066       # Cổng MySQL bên ngoài máy chủ (quản trị DB qua DBeaver/Navicat)
ES_EXPOSE_PORT=3067          # Cổng Elasticsearch REST API (http://<IP>:3067)
KVROCKS_EXPOSE_PORT=3068     # Cổng Kvrocks (Redis protocol tương thích)
NATS_EXPOSE_PORT=3069        # Cổng client NATS JetStream
NATS_MONITOR_PORT=3070       # Cổng Web Monitor NATS (http://<IP>:3070)

# ─────────────────────────────────────────────────────────────────────────────
# 2. ĐỊNH DANH CONTAINER, VOLUMES & MẠNG NỘI BỘ
# ─────────────────────────────────────────────────────────────────────────────
CONTAINER_PREFIX=ragflow
VOLUME_PREFIX=ragflow
NETWORK_NAME=ragflow_net
TIMEZONE=Asia/Ho_Chi_Minh

# ─────────────────────────────────────────────────────────────────────────────
# 3. MẬT KHẨU & TÀI KHOẢN HỆ THỐNG
# ─────────────────────────────────────────────────────────────────────────────
DEFAULT_SUPERUSER_EMAIL=admin@demego.vn
DEFAULT_SUPERUSER_PASSWORD=ThanNong@09102021
DEFAULT_SUPERUSER_NICKNAME=admin
ADMIN_DEFAULT_PASSWORD=ThanNong@09102021
ENABLE_REGISTER=0
REGISTER_ENABLED=0

MYSQL_DBNAME=rag_flow
MYSQL_PASSWORD=infini_rag_flow
ELASTIC_PASSWORD=infini_rag_flow
MINIO_USER=rag_flow
MINIO_PASSWORD=infini_rag_flow
REDIS_PASSWORD=infini_rag_flow

# ─────────────────────────────────────────────────────────────────────────────
# 4. TỐI ƯU HIỆU NĂNG & PHÂN BỔ BỘ NHỚ (RESOURCE TUNING)
# ─────────────────────────────────────────────────────────────────────────────
RAGFLOW_IMAGE=infiniflow/ragflow:v1.0.0-rc2
ES_JVM_HEAP=2g
